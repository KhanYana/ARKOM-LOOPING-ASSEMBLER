
org 100h

.data
    pesanInput db "Masukan nilai N: $"

    n db 0
    baris db 1
    kolom db 1
    jumlahAngka db 0
    spasi db 0

.code
    mov ax, @data
    mov ds, ax

    main proc

        ; =================================
        ; 1. INPUT NILAI N
        ; =================================

        mov dx, offset pesanInput
        mov ah, 09h
        int 21h

    handleInput:
        mov ax, 0
        int 16h

        cmp al, 0dh
        je inputFinish

        cmp al, '1'
        jb handleInput

        cmp al, '9'
        ja handleInput

        mov bl, al
        sub al, '0'

        test al, 1
        jz handleInput

        mov n, al

        mov dl, bl
        mov ah, 02h
        int 21h

        jmp handleInput

    inputFinish:

        ; Pindah baris setelah input
        mov ah, 02h
        mov dl, 0dh
        int 21h
        mov dl, 0ah
        int 21h

        ; =================================
        ; 2. MENENTUKAN JUMLAH BARIS
        ; =================================

        mov cx, 0
        mov cl, n

    ulangBaris:
        push cx

        ; =================================
        ; 3. MENGHITUNG JUMLAH ANGKA
        ; Rumus: (2 * baris) - 1
        ; =================================

        mov al, baris
        shl al, 1
        dec al
        mov jumlahAngka, al

        ; =================================
        ; 4. MENGHITUNG SPASI
        ; Rumus: 2 * (N - baris)
        ; =================================

        mov al, n
        sub al, baris
        shl al, 1
        mov spasi, al

        ; =================================
        ; 5. MENCETAK SPASI
        ; =================================

        mov cx, 0
        mov cl, spasi

    ulangSpasi:
        cmp cx, 0
        je cetakAngka

        mov dl, 32
        mov ah, 02h
        int 21h

        loop ulangSpasi

        ; =================================
        ; 6. MENCETAK ANGKA
        ; =================================

    cetakAngka:
        mov cx, 0
        mov cl, jumlahAngka
        mov kolom, 1

    ulangKolom:
        mov dl, kolom
        add dl, '0'
        mov ah, 02h
        int 21h

        cmp kolom, jumlahAngka
        je selesaiAngka

        mov dl, 32
        mov ah, 02h
        int 21h

        inc kolom
        loop ulangKolom

    selesaiAngka:

        ; =================================
        ; 7. PINDAH KE BARIS BERIKUTNYA
        ; =================================

        mov ah, 02h
        mov dl, 0dh
        int 21h
        mov dl, 0ah
        int 21h

        inc baris

        ; Mengambil kembali CX milik
        ; perulangan baris
        pop cx

        loop ulangBaris

    selesai:
        mov ah, 4ch
        int 21h

    main endp
