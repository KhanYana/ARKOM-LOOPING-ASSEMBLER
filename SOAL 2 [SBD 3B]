
org 100h

.data
    pesanInput db "Masukan nilai N: $"
    n db 0
    baris db 1
    kolom db 1
    tengah db 0
    jumlahAngka db 0
    spasi db 0

.code
    mov ax, @data
    mov ds, ax

    main proc

        ; ===== INPUT =====

        mov dx, offset pesanInput
        mov ah, 09h
        int 21h

        handleInput:
            mov ax, 0
            int 16h

            cmp al, 0dh
            je inputFinish

            ; Validasi input 1-9
            cmp al, '1'
            jb handleInput

            cmp al, '9'
            ja handleInput

            ; Mengubah ASCII menjadi angka
            mov bl, al
            sub al, '0'

            ; Memastikan angka ganjil
            test al, 1
            jz handleInput

            mov n, al

            ; Menampilkan angka input
            mov dl, bl
            mov ah, 02h
            int 21h

            jmp handleInput

        inputFinish:

            ; ===== PINDAH BARIS =====

            mov ah, 02h
            mov dl, 0dh
            int 21h
            mov dl, 0ah
            int 21h

            ; ===== MENENTUKAN TENGAH =====

            mov al, n
            inc al
            shr al, 1
            mov tengah, al

            ; ===== BAGIAN ATAS =====

            mov baris, 1
            mov cx, 0
            mov cl, tengah

        ulangAtas:
            push cx

            ; Menghitung jumlah angka
            mov al, baris
            shl al, 1
            dec al
            mov jumlahAngka, al

            ; Menghitung spasi kiri
            mov al, tengah
            sub al, baris
            shl al, 1
            mov spasi, al

            ; Mencetak spasi
            mov cx, 0
            mov cl, spasi

            ulangSpasi:
                cmp cx, 0
                je cetakAngka

                mov dl, 32
                mov ah, 02h
                int 21h

                loop ulangSpasi

            ; Mencetak angka
            cetakAngka:
                mov cx, 0
                mov cl, jumlahAngka
                mov kolom, 1

            ulangKolom:
                mov dl, kolom
                add dl, '0'
                mov ah, 02h
                int 21h

                ; Spasi antarangka
                cmp kolom, jumlahAngka
                je angkaSelesai

                mov dl, 32
                mov ah, 02h
                int 21h

                inc kolom
                loop ulangKolom

            angkaSelesai:

            ; Pindah baris
            mov ah, 02h
            mov dl, 0dh
            int 21h
            mov dl, 0ah
            int 21h

            inc baris
            pop cx
            loop ulangAtas

            ; ===== BAGIAN BAWAH =====

            mov al, tengah
            dec al
            mov baris, al

            mov cx, 0
            mov cl, baris

        ulangBawah:
            push cx

            ; Menghitung jumlah angka
            mov al, baris
            shl al, 1
            dec al
            mov jumlahAngka, al

            ; Menghitung spasi kiri
            mov al, tengah
            sub al, baris
            shl al, 1
            mov spasi, al

            ; Mencetak spasi
            mov cx, 0
            mov cl, spasi

            ulangSpasiBawah:
                cmp cx, 0
                je cetakAngkaBawah

                mov dl, 32
                mov ah, 02h
                int 21h

                loop ulangSpasiBawah

            ; Mencetak angka
            cetakAngkaBawah:
                mov cx, 0
                mov cl, jumlahAngka
                mov kolom, 1

            ulangKolomBawah:
                mov dl, kolom
                add dl, '0'
                mov ah, 02h
                int 21h

                cmp kolom, jumlahAngka
                je angkaSelesaiBawah

                mov dl, 32
                mov ah, 02h
                int 21h

                inc kolom
                loop ulangKolomBawah

            angkaSelesaiBawah:

            ; Pindah baris
            mov ah, 02h
            mov dl, 0dh
            int 21h
            mov dl, 0ah
            int 21h

            dec baris
            pop cx
            loop ulangBawah

        selesai:
            mov ah, 4ch
            int 21h

    main endp
