org 100h

.DATA
 yourName db "Insert Your Name: $"
 greetings db "Hi there 8D, $"
 nama db 50 dup('$')   ;ruang sebanyak 50 dan isinya ($,$,$,$,...dst)
 
.CODE
    mov ax, @data
    mov ds, ax
    
    mov dx, offset yourName
    mov ah, 09h
    int 21h
    
    ;mov si, 0        ; kosongin si nya (klo si nya pernah dipake dikosongin)
    handleInput:
        mov ax, 00h       ; 00h in ascii codes is null
        int 16h
        
        mov dl, al
        mov ah, 02h
        int 21h
        
        cmp al, 0dh
        je selesai
        
        mov nama[si], al ; hasil inputan kan masuknya al, nah dari al disimpan di si
        inc si           ; pindah ke next array nya misal (nama[0] isinya B -> pindah ke nama[1] isinya U -> dst)
        
        jmp handleInput
    
    selesai:
        ;input udh selesai dan mau print tulisan dan nama kita yang tadi di input
        
        ;mov nama[si], '$'  ; i still dont what this is
        ; atas ini kepake klo di .DATA pakainya "nama db ?"
        
        call newLine
        
        mov dx, offset greetings
        mov ah, 09h
        int 21h
        
        mov dx, offset nama
        mov ah, 09h
        int 21h
    
    
    newLine:
        push ax
        push dx
        
        mov ah, 02h
        mov dl, 0ah
        int 21h
        
        mov dl, 0dh
        int 21h
        
        pop ax
        pop dx
        
        ret
ret 
